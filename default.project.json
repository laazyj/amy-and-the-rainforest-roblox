{
  "name": "AmyAndTheRainforest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "core": {
        "$path": "src/core"
      },
      "content": {
        "$path": "src/content"
      },
      "shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
