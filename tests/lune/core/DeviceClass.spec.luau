-- DeviceClass: PC, Phone or Tablet from the last input kind and the viewport.

local DeviceClass = require("../../../src/core/DeviceClass")

return function(t: any)
	local describe, it, expect = t.describe, t.it, t.expect

	describe("DeviceClass.pick", function()
		it("is PC for a pointer (keyboard or mouse) or a gamepad, whatever the viewport", function()
			local function pc(input: DeviceClass.InputKind)
				expect(DeviceClass.pick(input, 1280, 720)).toBe("PC")
				expect(DeviceClass.pick(input, 844, 390)).toBe("PC")
				expect(DeviceClass.pick(input, 1376, 1032)).toBe("PC")
			end
			pc("pointer")
			pc("gamepad")
		end)

		it("is Phone for touch on a 6-inch phone, and Tablet on an 11- to 13-inch tablet", function()
			expect(DeviceClass.pick("touch", 844, 390)).toBe("Phone")
			expect(DeviceClass.pick("touch", 667, 375)).toBe("Phone")
			expect(DeviceClass.pick("touch", 1180, 820)).toBe("Tablet")
			expect(DeviceClass.pick("touch", 1376, 1032)).toBe("Tablet")
		end)

		it("puts the phone/tablet boundary at a shorter side of 600 units", function()
			expect(DeviceClass.PHONE_SHORTER_SIDE).toBe(600)
			expect(DeviceClass.pick("touch", 1000, 599)).toBe("Phone")
			expect(DeviceClass.pick("touch", 1000, 599.5)).toBe("Phone")
			expect(DeviceClass.pick("touch", 1000, 600)).toBe("Tablet")
			expect(DeviceClass.pick("touch", 599, 1000)).toBe("Phone")
			expect(DeviceClass.pick("touch", 600, 1000)).toBe("Tablet")
		end)

		it("keeps the class across a rotation: it reads the shorter side", function()
			expect(DeviceClass.pick("touch", 390, 844)).toBe("Phone")
			expect(DeviceClass.pick("touch", 844, 390)).toBe("Phone")
			expect(DeviceClass.pick("touch", 1032, 1376)).toBe("Tablet")
			expect(DeviceClass.pick("touch", 1376, 1032)).toBe("Tablet")
		end)
	end)

	describe("DeviceClass.inputKind", function()
		it("reads UserInputType and PreferredInput names", function()
			expect(DeviceClass.inputKind("Keyboard")).toBe("pointer")
			expect(DeviceClass.inputKind("KeyboardAndMouse")).toBe("pointer")
			expect(DeviceClass.inputKind("MouseButton1")).toBe("pointer")
			expect(DeviceClass.inputKind("MouseWheel")).toBe("pointer")
			expect(DeviceClass.inputKind("Touch")).toBe("touch")
			expect(DeviceClass.inputKind("Gamepad1")).toBe("gamepad")
			expect(DeviceClass.inputKind("Gamepad")).toBe("gamepad")
		end)

		it("says nothing for inputs that do not tell the device, mouse movement included", function()
			expect(DeviceClass.inputKind("MouseMovement")).toBeNil()
			expect(DeviceClass.inputKind("Focus")).toBeNil()
			expect(DeviceClass.inputKind("Accelerometer")).toBeNil()
			expect(DeviceClass.inputKind("None")).toBeNil()
		end)
	end)

	describe("DeviceClass.starting", function()
		it("is the preferred input's kind, or touch for a touch screen with no keyboard", function()
			expect(DeviceClass.starting("Touch", false, true)).toBe("touch")
			expect(DeviceClass.starting("KeyboardAndMouse", true, false)).toBe("pointer")
			expect(DeviceClass.starting(nil, true, false)).toBe("touch")
			expect(DeviceClass.starting(nil, true, true)).toBe("pointer")
			expect(DeviceClass.starting("Unknown", false, true)).toBe("pointer")
		end)
	end)
end
